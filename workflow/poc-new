#!/usr/bin/env python3
"""Create a PoC repository in the shared Yocto project (step 1 of the PoC workflow).

    workflow/poc-new <name> [--title "Title Words"] [--project DIR]

<name>     lowercase words joined by '-', e.g. lowpower-display. The repository is
           <project>/rzg3l-<name> (or <project>/<name> if <name> already starts with rzg3l-).
--title    guide title, e.g. "LowPower Display" -> docs/RZG3L-LowPower-Display-Guide.md
           (default: the words of <name>, capitalized).
--project  the Yocto project directory (default: $RZ_POC_PROJECT, else ../rzg3l-bsp-v1 next to rz-mcp).

The layout follows rzg3l-lowpower-display (README.md, docs/, layers/, image/, tools/md2pdf.py)
plus design/ for the step 1-4 files; design/ is internal and not part of the deliverable.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
TEMPLATES = HERE / "templates"
DEFAULT_PROJECT = Path(os.environ.get("RZ_POC_PROJECT", HERE.parent.parent / "rzg3l-bsp-v1"))
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


def repo_name(name: str) -> str:
    return name if name.startswith("rzg3l-") else f"rzg3l-{name}"


def fill(text: str, subst: dict[str, str]) -> str:
    for k, v in subst.items():
        text = text.replace(k, v)
    return text


def copy_tree(src: Path, dst: Path, subst: dict[str, str], rename: dict[str, str]) -> None:
    for p in sorted(src.rglob("*")):
        rel = p.relative_to(src).as_posix()
        out = dst / rename.get(rel, rel)
        if p.is_dir():
            out.mkdir(parents=True, exist_ok=True)
        elif p.suffix == ".md":
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(fill(p.read_text(encoding="utf-8"), subst), encoding="utf-8")
        else:
            out.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(p, out)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("name")
    ap.add_argument("--title")
    ap.add_argument("--project", type=Path, default=DEFAULT_PROJECT)
    a = ap.parse_args()

    if not NAME_RE.match(a.name):
        sys.exit(f"invalid name {a.name!r}: use lowercase words joined by '-', e.g. lowpower-display")
    project = a.project.resolve()
    if not (project / "meta-renesas").is_dir() or not (project / "build").is_dir():
        sys.exit(f"{project} is not a Yocto project directory (needs meta-renesas/ and build/)")
    dst = project / repo_name(a.name)
    if dst.exists():
        sys.exit(f"{dst} already exists; continue that PoC instead (/rz-docs:poc {a.name})")

    words = a.name.removeprefix("rzg3l-").split("-")
    title = a.title or " ".join(w.capitalize() for w in words)
    guide = "RZG3L-" + "-".join(title.split()) + "-Guide"
    subst = {"{TITLE}": title, "{GUIDE}": guide, "{REPO}": dst.name}

    copy_tree(TEMPLATES / "poc", dst, subst, {"gitignore": ".gitignore", "docs/GUIDE.md": f"docs/{guide}.md"})
    copy_tree(TEMPLATES / "design", dst / "design", {"{TITLE}": title}, {})

    git = ["git", "-C", str(dst)]
    subprocess.run(git + ["init", "-q", "-b", "main"], check=True)
    subprocess.run(git + ["add", "-A"], check=True)
    r = subprocess.run(git + ["commit", "-q", "-m", f"Start {dst.name} (poc-new)"])
    if r.returncode != 0:
        print("warning: git commit failed (is git user.name/user.email set?); files are staged", file=sys.stderr)
    print(dst)


if __name__ == "__main__":
    main()
