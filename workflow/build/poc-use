#!/usr/bin/env python3
"""Switch the shared Yocto build directory to a PoC (step 5; plan/PoC_Workflow_Plan.md section 4).

    workflow/build/poc-use <poc>               build/conf = official template + rz-mcp standard + <poc>/build-conf
    workflow/build/poc-use --baseline          build/conf = official template + rz-mcp standard
    workflow/build/poc-use --capture <poc>     write <poc>/build-conf from the current build/conf
    options: --project DIR (default $RZ_POC_PROJECT or ../rzg3l-bsp-v1), --build-dir DIR, --dry-run

<poc> is a PoC repository (path, or name under the project such as rzg3l-lowpower-display). Its build-conf/ has:
    layers       one layer per line, relative to the project directory (or absolute); '#' starts a comment
    local.conf   lines appended to local.conf as they are
A layer of an optional component (graphics, codecs, security, multi-os; catalog/bsp_releases.toml) that the
project does not have yet is installed first (workflow/build/yocto_setup.py: licensed packages from
rz-mcp/packages/ after their sha256 matches). --dry-run only reports it.
The official template is the release's TEMPLATECONF (catalog/bsp_releases.toml, bsp-plus-conf). The standard
part keeps the kernel, U-Boot and TF-A work directories (RM_WORK_EXCLUDE), which patch_stack and the designers
read. The previous build/conf files are kept in build/conf/backup/<time>/. Refuses while bitbake is running.
"""
import argparse
import datetime as dt
import hashlib
import json
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT / "src"))
from rzmcp import yocto as Y  # noqa: E402

sys.path.insert(0, str(ROOT / "workflow" / "build"))
import yocto_setup as S  # noqa: E402

STANDARD = ['MACHINE = "smarc-rzg3l"', 'RM_WORK_EXCLUDE += "linux-renesas u-boot trusted-firmware-a"']


def poc_repo(arg: str, project: Path) -> Path:
    p = Path(arg)
    for cand in (p, project / arg, project / f"rzg3l-{arg}"):
        if cand.is_dir():
            return cand.resolve()
    sys.exit(f"no PoC repository {arg!r} (tried {p}, {project / arg}, {project / ('rzg3l-' + arg)})")


def template(project: Path) -> Path:
    return project / Y.release()["template"]


def raw_blocks(text: str) -> list[tuple[str, str]]:
    """(raw text, normalised statement) per statement, continuation lines kept together, comments dropped."""
    out, cur = [], []
    for line in text.splitlines():
        if not cur and (not line.strip() or line.lstrip().startswith("#")):
            continue
        cur.append(line)
        if not line.rstrip().endswith("\\"):
            raw = "\n".join(cur)
            out.append((raw, Y.statements(raw)[0]))
            cur = []
    return out


def layer_line(layer: Path, project: Path, build: Path) -> str:
    """${TOPDIR}/../<layer> like the template when the build directory is <project>/build, else absolute."""
    if build == project / "build" and layer.is_relative_to(project):
        return f"${{TOPDIR}}/../{layer.relative_to(project)}"
    return str(layer)


def generate(project: Path, build: Path, layers: list[Path], extra_local: str, label: str) -> tuple[str, str]:
    t = template(project)
    base_layers = Y.bblayers(t / "bblayers.conf.sample", project / "build")   # the template assumes <project>/build
    all_layers = base_layers + [l for l in layers if l not in base_layers]
    head = [s for s in Y.statements((t / "bblayers.conf.sample").read_text()) if not s.startswith("BBLAYERS")]
    bbl = "\n".join(head) + '\n\nBBLAYERS ?= " \\\n' + "".join(f"  {layer_line(l, project, build)} \\\n" for l in all_layers) + '  "\n'
    bbl = f"# Generated by rz-mcp workflow/build/poc-use ({label}); edit {label}/build-conf instead.\n" + bbl
    local = (t / "local.conf.sample").read_text().rstrip("\n")
    local += "\n\n# ---- rz-mcp workflow standard (workflow/build/poc-use) ----\n" + "\n".join(STANDARD) + "\n"
    if extra_local.strip():
        local += f"\n# ---- {label}/build-conf/local.conf ----\n" + extra_local.strip("\n") + "\n"
    return bbl, local


def read_fragment(poc: Path, project: Path, dry_run: bool = False) -> tuple[list[Path], str]:
    d = poc / "build-conf"
    if not (d / "layers").exists():
        sys.exit(f"{d}/layers missing: create it, or capture the current configuration with --capture {poc.name}")
    layers = []
    for line in (d / "layers").read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            p = Path(line) if Path(line).is_absolute() else project / line
            if not (p / "conf" / "layer.conf").exists():
                rel = str(p.relative_to(project)) if p.is_relative_to(project) else line
                comp = Y.component_for_layer(rel)
                if not comp:
                    sys.exit(f"{d}/layers: {line} is not a layer (no conf/layer.conf)")
                if dry_run:
                    print(f"# would install the optional component {comp['name']} for {rel}", file=sys.stderr)
                else:
                    try:
                        print(*S.add_components(project, [comp["name"]]), sep="\n")
                    except S.SetupError as e:
                        sys.exit(f"{d}/layers: {line} needs the optional component {comp['name']}: {e}")
                if rel in comp.get("legacy_layers", []) and not (p / "conf" / "layer.conf").exists():
                    p = project / comp["layers"][0]          # the PoC names the old layout of rzg3l-bsp-v1
                    print(f"note: {line} is the old layout; using {comp['layers'][0]}", file=sys.stderr)
            layers.append(p.resolve())
    local = (d / "local.conf").read_text() if (d / "local.conf").exists() else ""
    return layers, local


def capture(poc: Path, project: Path, build: Path) -> None:
    t = template(project)
    base_layers = Y.bblayers(t / "bblayers.conf.sample", project / "build")
    cur_layers = Y.bblayers(build / "conf" / "bblayers.conf", build)
    tmpl = set(Y.statements((t / "local.conf.sample").read_text())) | {Y.statements(s)[0] for s in STANDARD}
    keep = [raw for raw, st in raw_blocks((build / "conf" / "local.conf").read_text()) if st not in tmpl]
    d = poc / "build-conf"
    d.mkdir(exist_ok=True)
    rel = [str(l.relative_to(project)) if l.is_relative_to(project) else str(l) for l in cur_layers if l not in base_layers]
    (d / "layers").write_text(f"# Layers on top of {Y.release()['template']} (captured {dt.date.today()})\n" + "\n".join(rel) + "\n")
    (d / "local.conf").write_text("\n".join(keep) + "\n")
    print(f"captured {len(rel)} layer(s) and {len(keep)} local.conf statement(s) into {d}")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("poc", nargs="?")
    ap.add_argument("--baseline", action="store_true")
    ap.add_argument("--capture", action="store_true")
    ap.add_argument("--project", type=Path, default=Y.project_dir())
    ap.add_argument("--build-dir", type=Path)
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    project = a.project.resolve()
    build = (a.build_dir or project / "build").resolve()
    if not a.baseline and not a.poc:
        sys.exit("give a PoC, or --baseline")
    poc = poc_repo(a.poc, project) if a.poc else None
    if a.capture:
        capture(poc, project, build)
        return
    if not a.dry_run and Y.bitbake_busy(build):
        sys.exit(f"bitbake is running in {build}; wait for it to finish")
    layers, extra = read_fragment(poc, project, a.dry_run) if poc else ([], "")
    label = poc.name if poc else "baseline"
    bbl, local = generate(project, build, layers, extra, label)
    conf = build / "conf"
    if a.dry_run:
        print(bbl)
        print(local[-2000:])
        return
    if Y.bitbake_busy(build):
        sys.exit(f"bitbake is running in {build}; wait for it to finish")
    conf.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = conf / "backup" / stamp
    for f in ("bblayers.conf", "local.conf", "templateconf.cfg", "poc-use.json"):
        if (conf / f).exists():
            backup.mkdir(parents=True, exist_ok=True)
            shutil.copy2(conf / f, backup / f)
    (conf / "bblayers.conf").write_text(bbl)
    (conf / "local.conf").write_text(local)
    (conf / "templateconf.cfg").write_text(str(template(project)) + "/\n")
    frag = hashlib.sha256((bbl + local).encode()).hexdigest()
    (conf / "poc-use.json").write_text(json.dumps({"poc": label, "repo": str(poc) if poc else None, "applied": stamp,
                                                   "template": Y.release()["template"], "conf_sha256": frag}, indent=1))
    print(f"build/conf is now {label}: {len(layers)} extra layer(s); previous files in {backup if backup.exists() else '(none)'}")


if __name__ == "__main__":
    main()
