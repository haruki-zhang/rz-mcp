#!/usr/bin/env python3
"""Take the source snapshot of a Yocto project: what the OFFICIAL configuration compiles (the release's layers plus
the optional components installed in the project; PoC layers are left out). bsp_source / bsp_grep / patch_stack /
build_facts / bsp_recipe read it.

    workflow/build/src-snapshot [--project DIR]              sources and resolved recipes (about 1-2 minutes)
    workflow/build/src-snapshot [--project DIR] --artifacts  also build the kernel and configure U-Boot in a scratch
                                                             TMPDIR to keep .config, compiled objects, DT (+5-10 min,
                                                             about 10 GB while it runs, deleted afterwards)

Nothing in the project is written: bitbake runs in data/snapshots/<slug>/build with its own TMPDIR, DL_DIR and
SSTATE_DIR (the project's DL_DIR and sstate-cache are only read, through PREMIRRORS / SSTATE_MIRRORS), and the
views only add objects the patches create (never re-writes an object the project's git mirrors already hold).
"""
import argparse
import datetime as dt
import gzip
import json
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT / "src"))
from rzmcp import snapshot as S  # noqa: E402
from rzmcp import yocto as Y  # noqa: E402

CONTAINER = Y.CONTAINER


def say(*a):
    print(*a, flush=True)


def official_layers(project: Path, rel: dict) -> tuple[list[Path], list[str]]:
    """The official template's BBLAYERS plus the optional components' layers present in the project."""
    tmpl = project / rel["template"]
    layers = Y.bblayers(tmpl / "bblayers.conf.sample", project / "build")
    opt = []
    for c in Y.optional_components(rel):
        for l in c["layers"] + c.get("legacy_layers", []):
            if (project / l / "conf" / "layer.conf").exists():
                layers.append((project / l).resolve())
                opt.append(c["name"])
                break
    return layers, opt


def write_conf(build: Path, project: Path, rel: dict, layers: list[Path]) -> None:
    conf = build / "conf"
    conf.mkdir(parents=True, exist_ok=True)
    dl = Y.dl_dir(project)
    sample = (project / rel["template"] / "local.conf.sample").read_text()
    (conf / "local.conf").write_text(sample + f"""
# ---- rz-mcp src-snapshot: a scratch build of the official configuration; the project is only read
MACHINE = "{rel['machine']}"
TMPDIR = "{build}/tmp"
DL_DIR = "{build}/downloads"
SSTATE_DIR = "{build}/sstate-cache"
PREMIRRORS:prepend = "git://.*/.* git://{dl}/git2/MIRRORNAME;protocol=file \\n gitsm://.*/.* git://{dl}/git2/MIRRORNAME;protocol=file \\n git://.*/.* file://{dl}/ \\n gitsm://.*/.* file://{dl}/ \\n https?://.*/.* file://{dl}/ \\n ftp://.*/.* file://{dl}/ \\n"
MIRRORS:prepend = "git://.*/.* file://{dl}/ \\n gitsm://.*/.* file://{dl}/ \\n https?://.*/.* file://{dl}/ \\n"
SSTATE_MIRRORS = "file://.* file://{project}/build/sstate-cache/PATH"
BB_NO_NETWORK = "1"
BB_GENERATE_MIRROR_TARBALLS = "0"
""")
    (conf / "bblayers.conf").write_text('POKY_BBLAYERS_CONF_VERSION = "2"\nBBPATH = "${TOPDIR}"\nBBFILES ?= ""\n'
                                        'BBLAYERS ?= " \\\n' + "".join(f"  {l} \\\n" for l in layers) + '  "\n')
    (conf / "templateconf.cfg").write_text(str(project / rel["template"]) + "\n")


def container(build: Path, project: Path, script: str, log: Path) -> int:
    r = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", CONTAINER], capture_output=True, text=True)
    if r.stdout.strip() != "true":
        subprocess.run(["docker", "start", CONTAINER], check=True, stdout=subprocess.DEVNULL)
    # bitbake runs from a private copy of poky/bitbake: it regenerates lib/bb/pysh/pyshtables.py (a git-ignored
    # parser cache) next to its own code on every run, which must not land in the project
    bb = build / "bitbake-copy"
    shutil.rmtree(bb, ignore_errors=True)
    shutil.copytree(project / "poky" / "bitbake", bb, ignore=shutil.ignore_patterns("__pycache__", "pyshtables.py"))
    full = (f"export PYTHONDONTWRITEBYTECODE=1; cd {shlex.quote(str(project))} && "
            f"source poky/oe-init-build-env {shlex.quote(str(build))} >/dev/null && "
            f"export PATH={shlex.quote(str(bb / 'bin'))}:$PATH && {script}")
    with open(log, "a") as f:
        return subprocess.run(["docker", "exec", CONTAINER, "bash", "-c", full], stdout=f, stderr=subprocess.STDOUT).returncode


def take_env(build: Path, project: Path, recipes: list[str], out: Path) -> dict:
    out.mkdir(parents=True, exist_ok=True)
    raw = build / "env-raw"
    shutil.rmtree(raw, ignore_errors=True)
    raw.mkdir()
    loop = "; ".join(f"nice -n 10 bitbake -e {shlex.quote(r)} > {raw}/{r}.env 2> {raw}/{r}.err; echo {r} $? >> {raw}/rc"
                     for r in recipes)
    container(build, project, loop, build / "snapshot.log")
    rcs = dict(line.split() for line in (raw / "rc").read_text().splitlines())
    got = {}
    for r in recipes:
        if rcs.get(r) == "0":
            with open(raw / f"{r}.env", "rb") as fi, gzip.open(out / f"{r}.env.gz", "wb") as fo:
                shutil.copyfileobj(fi, fo)
            got[r] = "ok"
        else:
            err = (raw / f"{r}.err").read_text(errors="replace")
            m = re.search(r"Nothing PROVIDES '[^']+'.*", err)
            got[r] = "not provided by the official configuration" if m else "bitbake -e failed: " + err.strip()[-300:]
    shutil.rmtree(raw, ignore_errors=True)
    return got


def git_component(name: str, recipe: str, env: str, src: dict, dl: Path, views: Path) -> dict:
    url = next(u for u in src["fetch"] if u.split("://")[0] in ("git", "gitsm") or "protocol=" in u)
    mirror = dl / "git2" / S.mirror_name(url)
    names = dict(x.split("=", 1) for x in url.split(";")[1:] if "=" in x)
    rev = S.env_var(env, f"SRCREV_{names['name']}") if "name" in names else None
    rev = rev or S.env_var(env, "SRCREV")
    c = {"kind": "git", "recipe": recipe, "url": url.split(";")[0], "mirror": str(mirror), "rev": rev,
         "pv": S.env_var(env, "PV"), "license": S.env_var(env, "LICENSE")}
    if not (mirror / "objects").is_dir() or not S.exists(mirror, f"{rev}^{{commit}}"):
        c["status"] = f"the project's DL_DIR has no mirror with {rev[:12]} (not fetched there): source not served"
        return c
    # S relative to the checkout (git fetcher unpacks into WORKDIR/<destsuffix, default git>)
    workdir, s = S.env_var(env, "WORKDIR"), S.env_var(env, "S")
    dest = names.get("destsuffix", "git")
    sub = ""
    if s and workdir and s.startswith(f"{workdir}/{dest}/"):
        sub = s[len(f"{workdir}/{dest}/"):].strip("/")
    c["subdir"] = sub
    rev_tree = S.git(mirror, "rev-parse", f"{rev}^{{tree}}").strip()
    if sub:
        rev_tree = S.git(mirror, "rev-parse", f"{rev_tree}:{sub}").strip()
    c["rev_tree"] = rev_tree
    c["release_tree"], c["changed"] = S.apply_patches(views, rev_tree, src["patches"])
    c["repo"] = "views"
    return c


def tar_component(name: str, recipe: str, env: str, src: dict, local: Path) -> dict:
    tb = src["tarballs"][0]
    c = {"kind": "tar", "recipe": recipe, "tarball": tb["path"], "pv": S.env_var(env, "PV"),
         "license": S.env_var(env, "LICENSE"), "repo": "local"}
    if not tb["path"]:
        c["status"] = f"tarball {tb['name']} not found on FILESPATH"
        return c
    full = S.import_tar(local, tb["path"])
    workdir, s = S.env_var(env, "WORKDIR"), S.env_var(env, "S")
    sub = s[len(workdir) + 1:].strip("/") if s and workdir and s.startswith(workdir + "/") else ""
    c["subdir"] = sub
    c["rev_tree"] = S.git(local, "rev-parse", f"{full}:{sub}").strip() if sub else full
    c["release_tree"], c["changed"] = S.apply_patches(local, c["rev_tree"], src["patches"])
    import hashlib
    c["sha256"] = hashlib.sha256(Path(tb["path"]).read_bytes()).hexdigest()
    return c


def layer_of(path, layers: list[Path], project: Path) -> str | None:
    """The layer (relative to the project) a patch / fragment file comes from."""
    if not path:
        return None
    best = max((l for l in layers if Path(path).is_relative_to(l)), key=lambda l: len(str(l)), default=None)
    return str(best.relative_to(project)) if best and best.is_relative_to(project) else (str(best) if best else None)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--project", default=None, help="Yocto project (absolute path); default $RZ_POC_PROJECT or rzg3l-bsp-v1")
    ap.add_argument("--artifacts", action="store_true", help="also build kernel / configure U-Boot for .config, objects, DT")
    ap.add_argument("--keep-build", action="store_true", help="keep the scratch TMPDIR / DL_DIR after --artifacts")
    a = ap.parse_args()
    project = Y.resolve_project(a.project).resolve()
    st = Y.assess(project)
    if st["state"] != "usable":
        sys.exit(Y.describe(st))
    rel_name = st["release"]
    rel = Y.release(rel_name)
    dl = Y.dl_dir(project)
    snap = S.snap_dir(project)
    build = snap / "build"
    t0 = time.time()
    snap.mkdir(parents=True, exist_ok=True)
    (build / "snapshot.log").parent.mkdir(parents=True, exist_ok=True)
    (build / "snapshot.log").write_text("")

    layers, opt = official_layers(project, rel)
    write_conf(build, project, rel, layers)
    say(f"src-snapshot of {project} ({rel_name}); optional components: {', '.join(opt) or 'none'}")
    say(f"  scratch build directory {build} (log: snapshot.log)")

    sources = rel.get("sources", {})
    env_only = rel.get("sources_env_only", [])
    say(f"  bitbake -e for {len(sources) + len(env_only)} recipes ...")
    t = time.time()
    got = take_env(build, project, list(sources.values()) + env_only, snap / "env.new")
    say(f"    {sum(v == 'ok' for v in got.values())} resolved, {time.time() - t:.0f}s")

    # repositories for the views
    views, local = snap / "views.git.new", snap / "local.git.new"
    for d in (views, local):
        shutil.rmtree(d, ignore_errors=True)
        subprocess.run(["git", "init", "-q", "--bare", str(d)], check=True)
    mirrors = sorted(str(p / "objects") for p in (dl / "git2").glob("*") if (p / "objects").is_dir())
    (views / "objects" / "info" / "alternates").write_text("\n".join(mirrors) + "\n")

    comps = {}
    for name, recipe in sources.items():
        if got.get(recipe) != "ok":
            comps[name] = {"recipe": recipe, "status": got.get(recipe, "?")}
            say(f"  {name:<14} -      {recipe}: {comps[name]['status']}")
            continue
        env = gzip.open(snap / "env.new" / f"{recipe}.env.gz", "rt", errors="replace").read()
        src = S.resolve_src_uri(env)
        try:
            if any(u.split("://")[0] in ("git", "gitsm") for u in src["fetch"]):
                c = git_component(name, recipe, env, src, dl, views)
            elif src["tarballs"]:
                c = tar_component(name, recipe, env, src, local)
            else:
                c = {"kind": "binary", "recipe": recipe, "pv": S.env_var(env, "PV"), "license": S.env_var(env, "LICENSE"),
                     "files": [f["path"] or f["name"] for f in src["files"]],
                     "status": "prebuilt binaries only: no source in the release"}
        except Exception as e:      # one broken component must not lose the others
            c = {"recipe": recipe, "status": f"failed: {type(e).__name__}: {e}"}
        c["patches"] = [dict(p, layer=layer_of(p["path"], layers, project)) for p in src["patches"]]
        c["fragments"] = [dict(f, layer=layer_of(f["path"], layers, project)) for f in src["fragments"]]
        comps[name] = c
        n = len(src["patches"])
        say(f"  {name:<14} {c.get('kind', '-'):<6} " + (c.get("status") or
            f"rev {(c.get('rev') or c.get('sha256', ''))[:12]}  +{n} patch(es), {len(c.get('changed', {}))} file(s) changed"))

    # layers as components (recipes, bbappends, patches, config fragments)
    fps = {}
    for l in layers:
        rel_l = str(l.relative_to(project)) if l.is_relative_to(project) else str(l)
        fps[rel_l] = S.fingerprint(l)
    layer_roots = {}                                 # component name -> directory served
    for l in layers:
        if not l.is_relative_to(project):
            continue
        parts = l.relative_to(project).parts
        if parts[0] == "meta-rz-features":
            layer_roots.setdefault(parts[1], l)          # meta-rz-graphics, meta-rz-codecs, meta-rz-multi-os, ...
        else:
            layer_roots.setdefault(parts[0], project / parts[0])
    for top, root in layer_roots.items():
        pin = next((x["rev"] for x in rel["layers"] if x["name"] == top), None)
        if (root / ".git").exists() and pin and S.exists(root / ".git", f"{pin}^{{commit}}"):
            c = {"kind": "layer", "repo_path": str(root / ".git"), "rev": pin,
                 "rev_tree": S.git(root / ".git", "rev-parse", f"{pin}^{{tree}}").strip()}
        else:
            tree, skipped = S.import_dir(local, root)
            c = {"kind": "layer", "repo": "local", "rev_tree": tree, "imported_from": str(root),
                 "skipped": skipped[:50], "note": "not a git checkout at the release pin: imported from disk"}
        c["release_tree"] = c["rev_tree"]
        comps[top] = c
        say(f"  {top:<14} layer  " + (f"git {c['rev'][:12]}" if "rev" in c else f"from disk ({len(c['skipped'])} large/binary files skipped)"))

    # refs keep the views reachable (a stray `git gc` must not prune them) and let repack pack them;
    # views.git: -l = never copy objects borrowed from the project's mirrors (reading them does not touch them)
    for name, c in comps.items():
        if "rev_tree" in c and not c.get("repo_path"):
            repo = views if c.get("repo") == "views" else local
            for v in ("rev", "release"):
                subprocess.run(["git", f"--git-dir={repo}", "update-ref", f"refs/rz/{name}/{v}", c[f"{v}_tree"]], check=True)
    subprocess.run(["git", f"--git-dir={local}", "repack", "-a", "-d", "-q"], check=True)
    subprocess.run(["git", f"--git-dir={views}", "repack", "-a", "-d", "-l", "-q", "--no-write-bitmap-index"], check=True)

    out = {"project": str(project), "release": rel_name, "created": dt.datetime.now().isoformat(timespec="seconds"),
           "optional": opt, "layers": [str(l) for l in layers], "layer_fingerprints": fps,
           "recipes": got, "components": comps, "artifacts": {}}

    if a.artifacts:
        say("  artifacts: bitbake -c compile_kernelmodules linux-renesas; bitbake -c configure u-boot (scratch TMPDIR) ...")
        t = time.time()
        rc = container(build, project, "nice -n 10 bitbake -c compile_kernelmodules linux-renesas && "
                                        "nice -n 10 bitbake -c configure u-boot", build / "snapshot.log")
        if rc:
            say(f"    FAILED (rc {rc}), see {build / 'snapshot.log'}")
        else:
            out["artifacts"] = collect_artifacts(build, snap, rel)
            out["artifacts"]["seconds"] = int(time.time() - t)
            say(f"    kept: {', '.join(k for k in out['artifacts'] if k != 'seconds')}; {time.time() - t:.0f}s")

    if not a.keep_build:                             # keep only conf/ and snapshot.log of the scratch build
        for d in ("tmp", "downloads", "sstate-cache", "cache", "bitbake-copy"):
            shutil.rmtree(build / d, ignore_errors=True)
    # swap in atomically-ish: old views stay valid until snapshot.json points to the new ones
    for new, final in ((snap / "env.new", snap / "env"), (views, snap / "views.git"), (local, snap / "local.git")):
        shutil.rmtree(final, ignore_errors=True)
        new.rename(final)
    if not a.artifacts:
        old = S.load(project)
        if old and old.get("artifacts"):
            out["artifacts"] = old["artifacts"]
            out["artifacts"]["note"] = f"kept from the snapshot of {old['created']} (run with --artifacts to refresh)"
    (snap / "snapshot.json.tmp").write_text(json.dumps(out, indent=1, ensure_ascii=False))
    (snap / "snapshot.json.tmp").replace(snap / "snapshot.json")
    size = sum(f.stat().st_size for f in snap.rglob("*") if f.is_file() and "build" not in f.relative_to(snap).parts[:1])
    say(f"done in {time.time() - t0:.0f}s: {snap} ({size / 1e6:.1f} MB)")


def collect_artifacts(build: Path, snap: Path, rel: dict) -> dict:
    """Copy .config, the compiled-object list, the DT(s) out of the scratch TMPDIR (paths relative to snap)."""
    arts = {}
    kenv = gzip.open(snap / "env.new" / "linux-renesas.env.gz", "rt", errors="replace").read()
    kb = Path(S.env_var(kenv, "B"))
    kd = snap / "kernel"
    shutil.rmtree(kd, ignore_errors=True)
    kd.mkdir()
    shutil.copy(kb / ".config", kd / ".config")
    objs = sorted(str(p.relative_to(kb)) for p in kb.rglob("*.o")
                  if not p.name.startswith(".") and not p.name.endswith(".mod.o") and "built-in" not in p.name)
    (kd / "objects.txt").write_text("\n".join(objs) + "\n")
    mods = (kb / "modules.order").read_text() if (kb / "modules.order").exists() else ""
    (kd / "modules.order").write_text(mods)
    dtc = kb / "scripts" / "dtc" / "dtc"
    dts_files = []
    for dtb in (S.env_var(kenv, "KERNEL_DEVICETREE") or "").split():
        f = kb / "arch" / "arm64" / "boot" / "dts" / dtb
        if not f.exists():
            continue
        name = Path(dtb).name
        shutil.copy(f, kd / name)
        pre = f.parent / f".{name}.dts.tmp"           # the preprocessed source: dtc keeps the labels
        src = pre if pre.exists() else f
        r = subprocess.run([str(dtc), "-q", "-I", "dts" if src == pre else "dtb", "-O", "dts", str(src)],
                           capture_output=True, text=True)
        (kd / f"{name}.dts").write_text(r.stdout)
        deps = (f.parent / f".{name}.cmd").read_text() if (f.parent / f".{name}.cmd").exists() else ""
        incl = sorted({m for m in re.findall(r"(arch/[^\s:\\]+\.dtsi?|include/[^\s:\\]+\.h)", deps)})
        (kd / f"{name}.sources").write_text("\n".join(incl) + "\n")
        dts_files.append(name)
    arts["kernel"] = {"config": "kernel/.config", "objects": "kernel/objects.txt", "modules": "kernel/modules.order",
                      "dtb": dts_files, "objects_count": len(objs)}
    uenv = gzip.open(snap / "env.new" / "u-boot.env.gz", "rt", errors="replace").read() if (snap / "env.new" / "u-boot.env.gz").exists() else ""
    ub = Path(S.env_var(uenv, "B") or "/nonexistent")
    cfgs = sorted(ub.glob("*/.config")) + ([ub / ".config"] if (ub / ".config").exists() else [])
    if cfgs:
        ud = snap / "u-boot"
        shutil.rmtree(ud, ignore_errors=True)
        ud.mkdir()
        names = []
        for c in cfgs:
            n = c.parent.name if c.parent != ub else "default"
            shutil.copy(c, ud / f"{n}.config")
            names.append(f"u-boot/{n}.config")
        arts["u-boot"] = {"config": names}
    return arts


if __name__ == "__main__":
    main()
