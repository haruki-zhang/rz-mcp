#!/usr/bin/env python3
"""Check, set up or extend a Yocto project for the RZ/G3L BSP release (catalog/bsp_releases.toml).

    workflow/build/yocto-project check  [DIR] [--json]       what DIR is; changes nothing
    workflow/build/yocto-project setup  DIR [--with graphics,codecs,security,multi-os] [--no-fetch]
    workflow/build/yocto-project add    DIR COMPONENT ...    install optional components into a usable project

check classifies DIR (default $RZ_POC_PROJECT or ../rzg3l-bsp-v1):
    absent      does not exist, or is empty (.claude/, .vscode/ and PoC repositories do not count)
    incomplete  an earlier `setup` did not finish (it can be run again and continues)
    usable      the release's layers are there and match it: reused as it is
    unusable    anything else: setup refuses and changes nothing
    exit status 0 usable, 1 absent / incomplete, 2 unusable

setup makes DIR usable: reuses a usable project (only adds what is missing: requested components, build/conf,
the official sources); otherwise clones poky, meta-arm, meta-openembedded and meta-renesas at the release's pins,
writes the baseline build/conf (poc-use --baseline) and fetches the official kernel / U-Boot / TF-A sources in the
build container. Measured 2026-11-26: 6 minutes and 4.3 GB, nearly all downloads (slower on a slow network). DIR must be visible to the container at the same path.
It does not build an image: run `workflow/build/poc-build --project DIR core-image-minimal` for that (hours).
No cache is shared with other projects. Exit status 0 done, 1 failed (run it again to continue), 2 refused, 3 busy.

Optional components (graphics, codecs, security: licensed packages kept in rz-mcp/packages/ and checked by sha256;
multi-os: git) are installed by `add`, by `setup --with`, or by poc-use when a PoC's build-conf/layers names one
of their layers.
"""
import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import yocto_setup as S  # noqa: E402
from rzmcp import yocto as Y  # noqa: E402


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("dir", nargs="?")
    c.add_argument("--json", action="store_true")
    s = sub.add_parser("setup")
    s.add_argument("dir")
    s.add_argument("--with", dest="with_", default="", help="comma-separated optional components")
    s.add_argument("--no-fetch", action="store_true", help="do not fetch the official sources (no bsp_source yet)")
    d = sub.add_parser("add")
    d.add_argument("dir")
    d.add_argument("components", nargs="+")
    a = ap.parse_args()
    try:
        project = Y.resolve_project(a.dir)
    except ValueError as e:
        sys.exit(str(e))

    if a.cmd == "check":
        r = Y.assess(project)
        print(json.dumps(r, indent=1, ensure_ascii=False) if a.json else Y.describe(r))
        sys.exit({"usable": 0, "absent": 1, "incomplete": 1, "unusable": 2}[r["state"]])
    try:
        if a.cmd == "setup":
            S.setup(project, [x for x in a.with_.split(",") if x.strip()], fetch=not a.no_fetch)
        else:
            r = Y.assess(project)
            if r["state"] != "usable":
                print(Y.describe(r))
                sys.exit(2)
            for line in S.add_components(project, a.components):
                print(line)
    except S.SetupError as e:
        msg = str(e)
        print(f"yocto-project: {msg}", file=sys.stderr)
        sys.exit(3 if "is running" in msg or "another yocto-project run" in msg else
                 2 if msg.startswith(("not usable", "unknown component")) else 1)


if __name__ == "__main__":
    main()
