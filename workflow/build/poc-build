#!/usr/bin/env python3
"""Run bitbake for the shared Yocto project inside the build container (step 5).

    workflow/build/poc-build <target> [<target> ...] [--task populate_sdk] [--project DIR] [--container max-ubuntu22.04]

The host runs Ubuntu 26.04; the BSP is built on Ubuntu 22.04 (Start-up Guide 2.1), in the container that mounts
the workspace at the same path. Only one bitbake at a time per build directory: refuses while one is running.
Each run leaves data/build-runs/<time>-<targets>/ with bitbake.log and report.json (which build/conf it used,
task summary, errors, the deploy files it produced).
"""
import argparse
import datetime as dt
import json
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT / "src"))
from rzmcp import yocto as Y  # noqa: E402

DEPLOY = "tmp/deploy/images/smarc-rzg3l"


def container_running(name: str) -> bool:
    r = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", name], capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.strip() == "true"


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("targets", nargs="+")
    ap.add_argument("--task", help="bitbake -c TASK, e.g. populate_sdk")
    ap.add_argument("--container", default="max-ubuntu22.04")
    ap.add_argument("--project", type=Path, default=Y.project_dir())
    ap.add_argument("--log-dir", type=Path, default=ROOT / "data" / "build-runs")
    a = ap.parse_args()
    project = a.project.resolve()
    build = project / "build"
    for t in a.targets + ([a.task] if a.task else []):
        if not re.fullmatch(r"[A-Za-z0-9_.+-]+", t):
            sys.exit(f"not a bitbake target or task name: {t!r}")
    if Y.bitbake_busy(build):
        sys.exit(f"bitbake is already running in {build}")
    if not container_running(a.container):
        print(f"starting container {a.container}")
        subprocess.run(["docker", "start", a.container], check=True, stdout=subprocess.DEVNULL)

    run = a.log_dir / f"{time.strftime('%Y%m%d-%H%M%S')}-{'-'.join(a.targets)[:60]}"
    run.mkdir(parents=True, exist_ok=True)
    log = run / "bitbake.log"
    conf = build / "conf" / "poc-use.json"
    bb = "bitbake " + (f"-c {a.task} " if a.task else "") + " ".join(a.targets)
    script = (f"cd {shlex.quote(str(project))} && source poky/oe-init-build-env build >/dev/null && "
              f"exec nice -n 10 {bb}")
    print(f"{bb}  (container {a.container}); log: {log}", flush=True)
    t0 = time.time()
    start = dt.datetime.now()
    with open(log, "w") as f:
        p = subprocess.Popen(["docker", "exec", a.container, "bash", "-c", script],
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in p.stdout:
            f.write(line)
            if line.startswith(("ERROR:", "NOTE: Tasks Summary", "Summary:")):
                print(line.rstrip(), flush=True)
        rc = p.wait()
    text = log.read_text(errors="replace")
    m = re.search(r"Tasks Summary: Attempted (\d+) tasks of which (\d+) didn't need to be rerun and (all succeeded|(\d+) failed)", text)
    produced = sorted(str(f.relative_to(build / DEPLOY)) for f in (build / DEPLOY).glob("*")
                      if f.is_file() and not f.is_symlink() and f.stat().st_mtime >= t0 - 1)
    report = {"command": bb, "project": str(project), "container": a.container, "start": start.isoformat(timespec="seconds"),
              "seconds": round(time.time() - t0), "exit": rc, "result": "OK" if rc == 0 else "FAILED",
              "conf": json.loads(conf.read_text()) if conf.exists() else "build/conf not written by poc-use",
              "tasks": {"attempted": int(m.group(1)), "not_rerun": int(m.group(2)),
                        "failed": 0 if m.group(3) == "all succeeded" else int(m.group(4))} if m else None,
              "errors": [l for l in text.splitlines() if l.startswith("ERROR:")][:50],
              "warnings": sum(1 for l in text.splitlines() if l.startswith("WARNING:")),
              "produced": produced}
    (run / "report.json").write_text(json.dumps(report, indent=1, ensure_ascii=False))
    print(f"{report['result']} in {report['seconds']}s; {len(produced)} new file(s) in {DEPLOY}; report: {run / 'report.json'}")
    sys.exit(rc)


if __name__ == "__main__":
    main()
