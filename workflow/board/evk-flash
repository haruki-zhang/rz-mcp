#!/usr/bin/env python3
"""RZ/G3L SMARC EVK: write the boot media over the console, without swapping cards (plan/PoC_Workflow_Plan.md 7.3).

  evk-flash doctor     [--image X] [--target emmc|qspi]   check host, connection and files; writes nothing
  evk-flash bootloader {emmc|qspi} [--image X]            SCIF download mode: BL2 + FIP (+ CM33) with Flash Writer
  evk-flash rootfs     --image X                          eMMC boot: the WIC to the eMMC user area from U-Boot (TFTP)
  evk-flash emmc       --image X                          bootloader emmc, then rootfs (works on a board without U-Boot)
  evk-flash clean      [--keep N]                         remove staged chunks of older images from the TFTP root

Images for QSPI or eSD boot on an SD card are written on the host (bmaptool); that is out of scope here.

--image is the <x>.wic.gz in the deploy directory (with <x>.wic.bmap). For `bootloader` it is optional but
recommended: the fip and CM33 firmware that the eSD WIC of the same build embeds are compared with the files to be
written, which proves they come from one build and picks the right CM33 firmware.

Each run leaves data/board-runs/<time>-<command>/ with console.log, report.json and report.md.
Human steps are printed as ">>> 需要你操作：..."; the tool then watches the console, no keyboard input needed.
"""
import argparse
import datetime as dt
import fnmatch
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import evk     # noqa: E402
import media   # noqa: E402

RZ = HERE.parent.parent
IFACE = "enx207bd2aa6c7a"


# ---------------------------------------------------------------- run record

class Run:
    def __init__(self, name: str, log_dir: Path):
        self.t0 = time.time()
        self.dir = log_dir / f"{time.strftime('%Y%m%d-%H%M%S')}-{name}"
        self.dir.mkdir(parents=True, exist_ok=True)
        self.console = self.dir / "console.log"
        self.data = {"command": name, "argv": sys.argv[1:], "start": dt.datetime.now().isoformat(timespec="seconds"),
                     "steps": [], "written": [], "checks": []}
        print(f"run record: {self.dir}")

    def step(self, name: str, **kw) -> None:
        rec = {"t": round(time.time() - self.t0, 1), "step": name, **kw}
        self.data["steps"].append(rec)

    def finish(self, ok: bool, error: str | None = None) -> None:
        d = self.data
        d.update(end=dt.datetime.now().isoformat(timespec="seconds"), seconds=round(time.time() - self.t0),
                 result="OK" if ok else "FAILED", error=error, versions=versions(self.console))
        (self.dir / "report.json").write_text(json.dumps(d, indent=1, ensure_ascii=False))
        lines = [f"# evk-flash {d['command']}: {d['result']}", "",
                 f"- start {d['start']}, {d['seconds']} s, args: `{' '.join(d['argv'])}`"]
        if error:
            lines.append(f"- error: {error}")
        for k, v in d["versions"].items():
            lines.append(f"- {k}: {v}")
        if d["checks"]:
            lines += ["", "| check | result | detail |", "|---|---|---|"]
            lines += [f"| {c['name']} | {c['result']} | {c['detail']} |" for c in d["checks"]]
        if d["written"]:
            lines += ["", "| what | file | to | sha256 | bytes |", "|---|---|---|---|---|"]
            lines += [f"| {w['what']} | {w['file']} | {w['to']} | `{w['sha256'][:16]}` | {w['bytes']} |" for w in d["written"]]
        lines += ["", "| t (s) | step | detail |", "|---|---|---|"]
        for s in d["steps"]:
            extra = ", ".join(f"{k}={v}" for k, v in s.items() if k not in ("t", "step"))
            lines.append(f"| {s['t']} | {s['step']} | {extra} |")
        (self.dir / "report.md").write_text("\n".join(lines) + "\n")
        print(f"report: {self.dir / 'report.md'}")


def versions(console: Path) -> dict:
    if not console.exists():
        return {}
    text = console.read_text(errors="replace")
    found = {}
    for key, rx in (("flash_writer", r"Flash writer for RZ/G3L[^\n]*"), ("bootrom", r"SCIF? Download mode[^\n]*"),
                    ("bl2", r"BL2: v[^\n]*"), ("bl2_built", r"BL2: Built[^\n]*"), ("bl31", r"BL31: v[^\n]*"),
                    ("u_boot", r"U-Boot 20\d\d\.\d\d[^\n]*")):
        m = re.findall(rx, text)
        if m:
            found[key] = m[-1].strip()
    return found


def sha256(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


# ---------------------------------------------------------------- files

def image_paths(image: Path) -> tuple[Path, Path, str]:
    image = image.resolve()
    bmap = Path(str(image).replace(".wic.gz", ".wic.bmap"))
    if not image.name.endswith(".wic.gz") or not image.exists() or not bmap.exists():
        sys.exit(f"need an existing .wic.gz with its .wic.bmap: {image}")
    image_id = f"{image.name.removesuffix('.wic.gz')}-{hashlib.sha256(bmap.read_bytes()).hexdigest()[:8]}"
    return image, bmap, image_id


def resolve_boot_files(target: str, deploy: Path, image: Path | None, cm33: str) -> tuple[list, list]:
    """The files to write for target, checked. Returns (files, checks). Exits on a hard error."""
    table = media.EMMC if target == "emmc" else media.QSPI
    checks = []
    candidates = sorted(p.name for p in deploy.glob(media.CM33_GLOB))
    head = evk.wic_read(image, 0, 4 << 20) if image else None
    chosen = None
    if cm33 == "none":
        chosen = None
    elif cm33 != "auto":
        if cm33 not in candidates:
            sys.exit(f"--cm33 {cm33}: not in {deploy} (candidates: {candidates})")
        chosen = cm33
    elif head is not None:                 # the image says which CM33 firmware belongs to it
        sec = next(f.wic_sector for f in table if f.role == "cm33")
        for c in candidates:
            b = (deploy / c).with_suffix(".bin").read_bytes()
            if head[sec * 512:sec * 512 + len(b)] == b:
                chosen = c
        region = head[sec * 512:sec * 512 + 4096]
        if chosen is None and region.strip(b"\0\xff"):
            sys.exit(f"the image embeds a CM33 firmware at sector {sec}, but none of {candidates} matches it")
        checks.append({"name": "cm33 from image", "result": "OK", "detail": chosen or "image has no CM33 firmware"})
    elif len(candidates) == 1:
        chosen = candidates[0]
        checks.append({"name": "cm33", "result": "WARN", "detail": f"only candidate {chosen}; give --image to confirm"})
    elif candidates:
        sys.exit(f"several CM33 firmwares in {deploy}: {candidates}; give --image or --cm33 NAME|none")
    files = [f if f.role != "cm33" else media.BootFile(**{**f.__dict__, "srec": chosen})
             for f in table if f.role != "cm33" or chosen]
    for name in [media.FLASH_WRITER] + [f.srec for f in files]:
        if not (deploy / name).exists():
            sys.exit(f"missing {deploy / name}")
    ordered = sorted(files, key=lambda f: f.dest)
    for i, f in enumerate(ordered):
        lo, data = evk.srec_decode(deploy / f.srec)
        binf = (deploy / f.srec).with_suffix(".bin")
        if lo != f.prog:
            sys.exit(f"{f.srec}: data starts at {lo:#x}, not at the program address {f.prog:#x}")
        if binf.exists() and binf.read_bytes() != data:
            sys.exit(f"{f.srec} does not match {binf.name}: files from different builds?")
        if head is not None and f.wic_sector is not None:
            if head[f.wic_sector * 512:f.wic_sector * 512 + len(data)] != data:
                sys.exit(f"{f.srec} differs from what the image embeds at sector {f.wic_sector}: "
                         "bootloader and rootfs are from different builds")
        if target == "emmc":
            start, end = f.dest * 512, f.dest * 512 + len(data)
            limit = (ordered[i + 1].dest * 512) if i + 1 < len(ordered) else media.EMMC_BOOT_PART_SECTORS * 512
            where = f"boot partition {media.EMMC_PARTITION} sector {f.dest:#x}..{(end - 1) // 512:#x}"
        else:
            start, end = f.dest, f.dest + len(data)
            limit = ordered[i + 1].dest if i + 1 < len(ordered) else media.QSPI_SIZE
            where = f"QSPI {f.dest:#x}..{end - 1:#x}"
        if end > limit:
            sys.exit(f"{f.srec} ({len(data)} bytes, {where}) overlaps the next file or the end of the medium")
        same = " = image" if head is not None and f.wic_sector is not None else ""
        checks.append({"name": f"{f.role} {f.srec}", "result": "OK",
                       "detail": f"{len(data)} bytes, {where}, load {f.prog:#x}, = {binf.name if binf.exists() else 'srec'}{same}"})
        print(f"check: {f.srec}: {len(data)} bytes -> {where}, load {f.prog:#x}{', equals .bin' if binf.exists() else ''}{same}")
    if head is None:
        checks.append({"name": "same build as image", "result": "WARN", "detail": "no --image: not checked"})
    return files, checks


# ---------------------------------------------------------------- host / connection checks

def sh(*cmd: str) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def host_checks(port: str, tftp_root: Path, need_bytes: int = 0) -> list:
    out = []

    def add(name, ok, detail, warn=False):
        out.append({"name": name, "result": "OK" if ok else ("WARN" if warn else "FAIL"), "detail": detail})

    add("pyserial", True, getattr(evk.serial, "__version__", "?"))
    real = os.path.realpath(port)
    add("console device", os.path.exists(port) and os.access(real, os.R_OK | os.W_OK),
        f"{port} -> {real}" if os.path.exists(port) else f"{port} missing (接上 Carrier II 的 'UART Debug' micro-USB 口)")
    if os.path.exists(port):
        try:
            evk.Console(port).close()
            add("console free", True, "not used by another program")
        except evk.BoardError as e:
            add("console free", False, str(e))
    add("dnsmasq", sh("systemctl", "is-active", "dnsmasq") == "active", sh("systemctl", "is-active", "dnsmasq") or "?")
    # the profile is inactive while the EVK is off (no carrier): check its settings, report the state
    prof = sh("nmcli", "-t", "-f", "connection.interface-name,ipv4.method,ipv4.addresses", "con", "show", "evk-direct")
    active = sh("nmcli", "-t", "-f", "GENERAL.STATE", "con", "show", "evk-direct").split(":")[-1] or "inactive"
    add("evk-direct", IFACE in prof and "manual" in prof and "192.168.50.1/24" in prof,
        f"{IFACE} 192.168.50.1/24, {active}" if prof else "no connection profile (run setup-host.sh)")
    carrier = Path(f"/sys/class/net/{IFACE}/carrier")
    link = carrier.exists() and carrier.read_text().strip() == "1"
    add("ethernet link", link, "up" if link else "no link (normal while the EVK is off)", warn=True)
    ok_dir = tftp_root.is_dir() and os.access(tftp_root, os.W_OK)
    free = shutil.disk_usage(tftp_root).free if tftp_root.exists() else 0
    add("tftp root", ok_dir and free > need_bytes, f"{tftp_root}, {free >> 30} GiB free")
    return out


def print_checks(checks: list) -> bool:
    for c in checks:
        print(f"  {c['result']:<4} {c['name']}: {c['detail']}")
    return all(c["result"] != "FAIL" for c in checks)


# ---------------------------------------------------------------- phases

def phase_bootloader(con: "evk.Console", run: Run, target: str, deploy: Path, files: list, a) -> None:
    state = "unknown" if a.bootrom_waiting else con.probe()
    run.step("probe", state=state)
    if state == "fw":
        print("flash writer: already running; skipping the download")
        if con.ser.baudrate != 921600:
            con.fw_speed_up()
    else:
        if not a.bootrom_waiting:
            evk.human(media.MSG_SCIF)
        run.step("human: SCIF download mode, power on")
        banner = con.scif_download(deploy / media.FLASH_WRITER, a.wait, already_waiting=a.bootrom_waiting)
        print("flash writer:", banner)
        run.step("flash writer", banner=banner)
        con.fw_speed_up()
    print("flash writer: 921600 bps")
    for f in files:
        t0 = time.time()
        data = evk.srec_decode(deploy / f.srec)[1]
        if target == "emmc":
            con.fw_em_w(media.EMMC_PARTITION, f.dest, f.prog, deploy / f.srec)
            to = f"eMMC boot partition {media.EMMC_PARTITION} sector {f.dest:#x}"
        else:
            got = con.fw_xls2(f.prog, f.dest, deploy / f.srec, len(data))
            to = f"QSPI {f.dest:#x}"
            if not got["matches"]:
                print(f"  warning: Flash Writer reported {got} for {f.srec} ({len(data)} bytes at {f.dest:#x})")
            run.step("xls2 reported", file=f.srec, **{k: (hex(v) if isinstance(v, int) else v) for k, v in got.items()})
        secs = round(time.time() - t0)
        print(f"{'EM_W' if target == 'emmc' else 'XLS2'} {f.srec} -> {to} (load {f.prog:#x}) OK ({secs}s)")
        run.data["written"].append({"what": f.role, "file": f.srec, "to": to, "bytes": len(data),
                                    "sha256": hashlib.sha256(data).hexdigest()})
        run.step("written", file=f.srec, to=to, seconds=secs)
    if target == "emmc":
        for idx, val in media.EMMC_EXT_CSD:
            con.fw_em_secsd(idx, val)
            print(f"EXT_CSD[{idx:#X}] = {val:#04x} OK")
            run.step("ext_csd", index=hex(idx), value=hex(val))
    con.baud(115200)


def phase_rootfs(con: "evk.Console", run: Run, image: Path, bmap: Path, image_id: str, a) -> None:
    rel = f"evk/{image_id}"
    man = evk.stage_image(image, bmap, a.tftp_root / rel, a.chunk_mb << 20)
    state = con.probe()
    run.step("probe", state=state)
    con.baud(115200)                      # probe() leaves 921600 when it finds Flash Writer; U-Boot runs at 115200
    if state != "uboot":
        con.stop_autoboot(a.wait, media.MSG_EMMC)
        run.step("human: eMMC boot, power on")
    card = con.mmc_select(0, 0)
    print(f"mmc 0 (user area): {card['type']}, {card['capacity'] / 2**30:.1f} GiB")
    if card["type"] != "MMC":
        raise evk.BoardError("mmc 0 is not the eMMC; set SYS[1] = OFF on the module")
    if card["capacity"] < man["image_size"]:
        raise evk.BoardError(f"eMMC too small: {card['capacity']} < image {man['image_size']} bytes")
    net = con.net_setup()
    print("network:", net)
    run.step("network", port=net)
    t0 = time.time()
    con.write_chunks(man, rel, verify=True)
    secs = round(time.time() - t0)
    run.step("rootfs written and read back", chunks=len(man["chunks"]), mapped_mib=round(man["mapped_bytes"] / 2**20),
             seconds=secs, mib_per_s=round(man["mapped_bytes"] / 2**20 / max(secs, 1), 2))
    run.data["written"].append({"what": "rootfs (WIC, mapped ranges)", "file": image.name, "to": "eMMC user area",
                                "bytes": man["mapped_bytes"], "sha256": sha256(image)})
    if not a.no_saveenv:                  # SUG 8.2.4: the eMMC boot environment
        con.cmd("env default -a")
        out = con.cmd("saveenv", timeout=30)
        if "OK" not in out:
            raise evk.BoardError(f"saveenv: {out!r}")
        print("env: default environment saved to eMMC")
        run.step("saveenv")
    boot_check(con, run, "reset", a.expect, a.wait)


def boot_check(con: "evk.Console", run: Run, how: str, expect: str, wait: float) -> None:
    con.buf = ""
    if how == "reset":
        con.send("reset\r")
    else:
        evk.human(how)
    t0 = time.time()
    con.expect([expect], wait)
    secs = round(time.time() - t0)
    print(f"boot check: '{expect}' seen {secs}s after {'reset' if how == 'reset' else 'the request above'}")
    run.step("boot check", expect=expect, seconds=secs)


# ---------------------------------------------------------------- commands

def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--port", default=evk.PORT)
    common.add_argument("--deploy", type=Path, help="deploy directory (default: the image's, else the BSP's)")
    common.add_argument("--tftp-root", type=Path, default=Path("/srv/tftp"))
    common.add_argument("--log-dir", type=Path, default=RZ / "data" / "board-runs")
    common.add_argument("--wait", type=float, default=900, help="seconds to wait for each manual step")
    common.add_argument("--cm33", default="auto", help="auto (from --image, else the only candidate) | none | file name")
    common.add_argument("--chunk-mb", type=int, default=64)
    common.add_argument("--bootrom-waiting", action="store_true",
                        help="the BootROM already printed its SCIF download banner: send Flash Writer at once")
    common.add_argument("--no-saveenv", action="store_true")
    common.add_argument("--expect", default=r"login:", help="regex that marks a successful boot (default 'login:')")
    common.add_argument("--skip-host-checks", action="store_true", help=argparse.SUPPRESS)   # eval/fake_uboot.py tests
    d = sub.add_parser("doctor", parents=[common])
    d.add_argument("--image", type=Path)
    d.add_argument("--target", choices=["emmc", "qspi"], default="emmc")
    b = sub.add_parser("bootloader", parents=[common])
    b.add_argument("target", choices=["emmc", "qspi"])
    b.add_argument("--image", type=Path)
    b.add_argument("--boot-check", choices=["none", "uboot", "login"], default="none",
                   help="after writing: a person switches to that boot mode and power-cycles; wait for U-Boot or login")
    r = sub.add_parser("rootfs", parents=[common])
    r.add_argument("--image", type=Path, required=True)
    e = sub.add_parser("emmc", parents=[common])
    e.add_argument("--image", type=Path, required=True)
    c = sub.add_parser("clean", parents=[common])
    c.add_argument("--keep", type=int, default=1, help="keep the N most recently staged images (default 1)")
    a = ap.parse_args()

    if a.cmd == "clean":
        staged = sorted((a.tftp_root / "evk").glob("*/manifest.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        for m in staged[a.keep:]:
            shutil.rmtree(m.parent)
            print(f"removed {m.parent}")
        print(f"kept {min(len(staged), a.keep)} staged image(s)")
        return

    image = bmap = image_id = None
    if getattr(a, "image", None):
        image, bmap, image_id = image_paths(a.image)
    deploy = (a.deploy or (image.parent if image else
              RZ.parent / "rzg3l-bsp-v1" / "build" / "tmp" / "deploy" / "images" / "smarc-rzg3l")).resolve()
    target = {"doctor": a.__dict__.get("target"), "bootloader": a.__dict__.get("target"), "emmc": "emmc"}.get(a.cmd)

    if a.cmd == "doctor":
        need = evk.read_bmap(bmap)["image_size"] if bmap else 0
        checks = [] if a.skip_host_checks else host_checks(a.port, a.tftp_root, need)
        files, fchecks = resolve_boot_files(target, deploy, image, a.cm33)
        checks += fchecks
        staged = list((a.tftp_root / "evk").glob("*/manifest.json"))
        checks.append({"name": "staged images", "result": "OK" if len(staged) <= 2 else "WARN",
                       "detail": f"{len(staged)} in {a.tftp_root / 'evk'} (evk-flash clean removes old ones)"})
        ok = print_checks(checks)
        print("doctor:", "OK" if ok else "FAIL")
        sys.exit(0 if ok else 1)

    run = Run(a.cmd if a.cmd != "bootloader" else f"bootloader-{target}", a.log_dir)
    run.data["checks"] = [] if a.skip_host_checks else host_checks(a.port, a.tftp_root)
    files = []
    try:
        if a.cmd in ("bootloader", "emmc"):
            files, fchecks = resolve_boot_files(target, deploy, image, a.cm33)
            run.data["checks"] += fchecks
        if not print_checks(run.data["checks"]):
            raise evk.BoardError("pre-flight checks failed (see above)")
        con = evk.Console(a.port, log=str(run.console))
        try:
            if a.cmd in ("bootloader", "emmc"):
                phase_bootloader(con, run, target, deploy, files, a)
            if a.cmd == "bootloader" and a.boot_check != "none":
                msg = media.MSG_EMMC if target == "emmc" else media.MSG_QSPI
                boot_check(con, run, msg, r"U-Boot 20\d\d" if a.boot_check == "uboot" else a.expect, a.wait)
            if a.cmd in ("rootfs", "emmc"):
                phase_rootfs(con, run, image, bmap, image_id, a)
        finally:
            con.close()
    except (evk.BoardError, TimeoutError, SystemExit) as e:
        msg = str(e) if not isinstance(e, SystemExit) else f"stopped: {e.code}"
        run.finish(False, msg)
        print(f"FAILED: {msg}")
        sys.exit(1)
    run.finish(True)
    print("OK")


if __name__ == "__main__":
    main()
