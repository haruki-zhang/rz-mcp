# Environment and build output
.venv/
__pycache__/
*.pyc
# Runtime data; data/.token is a secret. Only the document index rz.db is tracked
# (rebuild with `python -m rzmcp.build`)
data/*
!data/rz.db
# Raw vendor documents (872 MB, read-only, tracked by catalog/manifest.toml instead)
docs/
# Licensed Renesas software packages (graphics / codec / security): read-only, registered with sha256 in
# catalog/bsp_releases.toml; never commit them and never put them into a PoC delivery
packages/
# Machine configuration (template: config.example.toml)
config.toml
